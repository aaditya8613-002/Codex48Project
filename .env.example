# TiDB Cloud (MySQL compatible). TLS is enabled automatically for mysql URLs.
# Format: mysql+pymysql://USER:PASSWORD@HOST:4000/DBNAME
DATABASE_URL=mysql+pymysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/brandguard

# Google AI Studio key (free tier may train on submitted data: use made-up sample data only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Retrieval
RETRIEVAL_TOP_K=5
